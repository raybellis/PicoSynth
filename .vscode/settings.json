{
    "cmake.environment": {
        "PICO_SDK_PATH": "/opt/pico/pico-sdk",
        "PICO_EXTRAS_PATH": "/opt/pico/pico-extras",
        "PICO_HOME": "/opt/pico"
    },

    // CMake Tools shares build/ with the command line, so both see the
    // same cache and the same generated tables.  that cache pins
    // PICO_PLATFORM and PICO_BOARD, and configuring with a different
    // kit would overwrite them, which is why it is not allowed to
    // configure on its own initiative
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.configureOnOpen": false,

    // clangd reads the compile database from the command line build,
    // which is the one that has the generated headers in it.
    // --query-driver is what lets it ask the cross compiler where its
    // own system headers live
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/build",
        "--query-driver=/opt/local/bin/arm-none-eabi-*"
    ]
}
